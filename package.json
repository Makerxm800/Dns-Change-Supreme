{
  "name": "dns-change-supreme",
  "version": "2.0.0",
  "type": "module",
  "description": "DNS Change Supreme — Cross-platform Windows & macOS DNS Changer with All-Region Free DNS Servers, Real Country Flags, Live Latency Benchmark, Improved System Settings, and Git Auto-Updater.",
  "main": "electron/main.js",
  "author": "Makerxm800",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Makerxm800/Dns-Change-Supreme.git"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:vite\"",
    "dev:api": "node server/apiServer.js",
    "dev:vite": "vite --host 0.0.0.0 --port 5173",
    "electron:dev": "concurrently -k \"npm:dev:vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "build:win": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "build:all": "vite build && electron-builder --win --mac",
    "preview": "node server/apiServer.js --serve-dist",
    "test": "node --test tests/dnsEngine.test.mjs"
  },
  "dependencies": {
    "country-flag-icons": "^1.5.21",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "wait-on": "^8.0.2"
  }
}
